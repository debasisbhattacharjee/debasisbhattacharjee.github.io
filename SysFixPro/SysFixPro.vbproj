<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>SysFixPro</RootNamespace>
    <AssemblyName>SysFixPro</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>off</Nullable>
    <StartupObject>SysFixPro.Program</StartupObject>
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The HTML/CSS/JS UI is deployed next to the executable and loaded through
         WebView2's virtual host mapping (see MainForm.EnsureWebViewAsync). These files
         are already picked up by the SDK's default globs, so we only need to flag them
         for copying - using Update (not Include) avoids duplicate-item errors. -->
    <None Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
